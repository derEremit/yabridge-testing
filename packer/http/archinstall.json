{
  "config_version": "2.6.0",
  "additional-repositories": [],
  "archinstall-language": "English",
  "audio_config": {
    "audio": "pipewire"
  },
  "bootloader": "grub-install",
  "debug": false,
  "disk_config": {
    "config_type": "default_layout",
    "device_modifications": [
      {
        "device": "/dev/sda",
        "partitions": [],
        "wipe": true
      }
    ]
  },
  "hostname": "yabridge-test",
  "kernels": ["linux"],
  "locale_config": {
    "kb_layout": "us",
    "sys_enc": "UTF-8",
    "sys_lang": "en_US"
  },
  "mirror_config": {
    "custom_mirrors": [],
    "mirror_regions": {
      "Worldwide": [
        "https://geo.mirror.pkgbuild.com/$repo/os/$arch"
      ]
    }
  },
  "network_config": {
    "type": "nm"
  },
  "ntp": true,
  "packages": [
    "openssh",
    "curl",
    "wget",
    "git",
    "base-devel",
    "linux-headers",
    "networkmanager"
  ],
  "parallel_downloads": 5,
  "profile_config": {
    "profile": {
      "main": "minimal"
    }
  },
  "swap": true,
  "timezone": "UTC",
  "uki": false,
  "version": "2.6.0"
}
