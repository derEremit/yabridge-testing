#!/bin/bash
# Wine environment configuration for yabridge testing
# Generated by Ansible

export WINEPREFIX="{{ wine_prefix }}"
export WINEARCH="{{ wine_arch }}"
export WINEDEBUG="{{ wine_debug | default('-all') }}"

{% if wine_custom_install %}
export PATH="{{ wine_install_prefix }}/bin:$PATH"
export LD_LIBRARY_PATH="{{ wine_install_prefix }}/lib:$LD_LIBRARY_PATH"
{% endif %}

# yabridge-specific settings
export YABRIDGE_DEBUG_LEVEL="{{ yabridge_debug_level | default('0') }}"

# Display Wine version
echo "Wine environment configured:"
wine --version
